# ==========================================================
# Question 5: Type Conversion (Casting)
# ==========================================================
print("\n--- Question 5 ---")
age_input = input("Enter your age: ")
marks_input = input("Enter your marks: ")

# Display original types (input() always returns str)
print("\nBefore Conversion:")
print("Age:", age_input, "| Type:", type(age_input))
print("Marks:", marks_input, "| Type:", type(marks_input))

# Explicit casting
age_converted = int(age_input)
marks_converted = float(marks_input)

print("\nAfter Conversion:")
print("Age (int):", age_converted, "| Type:", type(age_converted))
print("Marks (float):", marks_converted, "| Type:", type(marks_converted))

# Performing arithmetic operations
future_age = age_converted + 5
total_marks = marks_converted + 10

print("\nArithmetic Operations:")
print("Age after 5 years:", future_age)
print("Marks after adding 10:", total_marks)


# ==========================================================
# Question 6: Implicit vs Explicit Type Conversion
# ==========================================================
print("\n--- Question 6 ---")
# Implicit type conversion
a = 10       # int
b = 2.5      # float
result_implicit = a + b
print("Implicit Conversion (int + float):", result_implicit)
print("Type:", type(result_implicit))

# Error example (commented out to avoid stopping execution)
# p = 10
# q = "Hello"
# print(p + q)  # Raises TypeError: unsupported operand type(s)

# Explicit type conversion (correct usage)
x = 10
y = "5"
y_converted = int(y)
result_explicit = x + y_converted
print("\nExplicit Conversion (int + str converted to int):", result_explicit)


# ==========================================================
# Question 7: Memory Behavior of Variables
# ==========================================================
print("\n--- Question 7 ---")
# Same value assigned to two variables (points to same memory location)
a = 10
b = 10
print("a id:", id(a))
print("b id:", id(b))

# Modifying one variable creates a new object in memory
a = 20
print("\nAfter modifying a:")
print("a:", a, "id:", id(a))
print("b:", b, "id:", id(b))


# ==========================================================
# Question 8: Swapping Variables Using Multiple Methods
# ==========================================================
print("\n--- Question 8 ---")
# Method 1: Using a third variable
a = 10
b = 20
print("Before swap (Method 1): a =", a, ", b =", b)
temp = a
a = b
b = temp
print("After swap (Method 1): a =", a, ", b =", b)

# Method 2: Python tuple unpacking
x = 10
y = 20
print("\nBefore swap (Method 2): x =", x, ", y =", y)
x, y = y, x
print("After swap (Method 2): x =", x, ", y =", y)


# ==========================================================
# Question 9: Data Type-Based Calculator
# ==========================================================
print("\n--- Question 9 ---")
val1 = input("Enter first value: ")
val2 = input("Enter second value: ")

# Check if both are numeric (integers or floats)
is_val1_numeric = val1.replace(".", "", 1).isdigit()
is_val2_numeric = val2.replace(".", "", 1).isdigit()

if is_val1_numeric and is_val2_numeric:
    num1 = float(val1)
    num2 = float(val2)
    sum_result = num1 + num2
    print("\nBoth inputs are numeric.")
    print("Sum:", sum_result)
elif val1.isalpha() and val2.isalpha():
    concat_result = val1 + val2
    print("\nBoth inputs are strings.")
    print("Concatenation:", concat_result)
else:
    print("\nInvalid input types. Cannot perform operation.")


