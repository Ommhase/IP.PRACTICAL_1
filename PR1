# --- Q1: Variable Creation and Naming Rules ---
name = "Asha"
age = 18
marks = 91.5
city = "Pune"
print("Q1:", name, age, marks, city)
# Invalid examples (commented out to prevent syntax errors):
# 1name = "Asha"   -> Cannot start with a number
